auto-install-peers=false
strict-peer-dependencies=false
# pnpm's default (isolated) node_modules only symlinks a package's
# transitive deps as SIBLINGS inside its own .pnpm virtual-store folder
# (e.g. node_modules/.pnpm/web-push@3.6.7/node_modules/asn1.js), never at
# the true top-level node_modules/. Netlify's Function bundler doesn't
# resolve that nested structure correctly (confirmed: "Cannot find module
# 'asn1.js'" even though web-push itself resolved fine) - shamefully-hoist
# forces every dependency, direct and transitive, to also get a real
# top-level node_modules/ symlink, which is what tools written for
# npm/yarn's classic flat layout expect. This is pnpm's own documented
# fix for exactly this compatibility class of problem.
shamefully-hoist=true
