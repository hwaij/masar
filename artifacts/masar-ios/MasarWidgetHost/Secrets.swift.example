// انسخ هذا الملف إلى Secrets.swift (بجانبه، نفس المجلد) واملأ القيمتين
// الحقيقيتين - Secrets.swift نفسه في .gitignore، لا يُرفع لـgit أبداً.
//
// القيمتان هما نفس VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY (أو
// VITE_SUPABASE_PUBLISHABLE_KEY) الموجودتان أصلاً في إعدادات Netlify لموقع
// مسار - تجدهما أيضاً في: Supabase Dashboard → Settings → API.
// المفتاح هنا هو anon/publishable العام الآمن للعميل (نفس المفتاح
// المُضمَّن فعلياً في تطبيق الويب) - ليس service_role أبداً، ولا يُستخدَم
// هنا مثله لأي غرض.
enum Secrets {
    static let supabaseURL = "https://YOUR_PROJECT.supabase.co"
    static let supabaseAnonKey = "YOUR_ANON_KEY"
}
